---
/**
 * Página de convocatorias.
 *
 * Lee el JSON estático en build y muestra una tarjeta por convocatoria;
 * si no hay datos, muestra el estado vacío.
 * Los filtros y la búsqueda se aplican dinámicamente en el cliente.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar.astro";
import FilterPanel from "../components/FilterPanel.astro";
import ConvocatoriaCard from "../components/ConvocatoriaCard.astro";
import EmptyState from "../components/EmptyState.astro";
import { obtenerConvocatorias } from "../utils/data";

const convocatorias = obtenerConvocatorias();

// Lista global de carreras: las tarjetas guardan índices en data-carreras
// y el script la recibe como JSON para traducirlos, en lugar de repetir
// los nombres completos en cada tarjeta (ahorra varios MB de HTML)
const listaCarreras = Array.from(
  new Set(convocatorias.flatMap((c) => c.carreras || []).map((c) => c.trim()))
).sort((a, b) => a.localeCompare(b));
const indicePorCarrera = new Map(listaCarreras.map((c, i) => [c, i]));
---

<BaseLayout
  titulo="Convocatorias"
  descripcion="Todas las convocatorias de servicio social disponibles, con filtros por apoyo económico, universidad, nivel, área, escuela, carrera y ubicación."
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Convocatorias
      </h1>
      <p class="mt-2 text-slate-650 dark:text-slate-350">
        Explora y filtra las plazas disponibles para tu servicio social.
      </p>
    </div>

    <div class="space-y-5">
      <SearchBar />
      <FilterPanel convocatorias={convocatorias} />
    </div>

    <div class="mt-10">
      {
        convocatorias.length === 0 ? (
          <EmptyState mensaje="Aún no hay convocatorias registradas." />
        ) : (
          <div>
            <div id="convocatorias-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {convocatorias.map((convocatoria) => (
                <ConvocatoriaCard
                  convocatoria={convocatoria}
                  indicePorCarrera={indicePorCarrera}
                />
              ))}
            </div>
            
            <div id="no-results-state" class="hidden py-8">
              <EmptyState mensaje="No encontramos convocatorias que coincidan con tus filtros." />
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Lista global de carreras para traducir los índices de data-carreras -->
  <script
    type="application/json"
    id="lista-carreras"
    set:html={JSON.stringify(listaCarreras)}
  />
</BaseLayout>

<script>
  // Obtener elementos del DOM
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const apoyoBtn = document.getElementById("filtro-apoyo");
  const nivelSelect = document.getElementById("filtro-nivel") as HTMLSelectElement | null;
  const escuelaSelect = document.getElementById("filtro-escuela") as HTMLSelectElement | null;
  const carreraSelect = document.getElementById("filtro-carrera") as HTMLSelectElement | null;
  const estadoSelect = document.getElementById("filtro-estado") as HTMLSelectElement | null;
  const municipioSelect = document.getElementById("filtro-municipio") as HTMLSelectElement | null;
  const limpiarBtn = document.getElementById("filtro-limpiar");
  const grid = document.getElementById("convocatorias-grid");
  const noResultsState = document.getElementById("no-results-state");
  const cards = document.querySelectorAll(".convocatoria-card");

  if (apoyoBtn && cards.length > 0) {
    // Lista global de carreras: data-carreras de cada tarjeta y el valor
    // que el filtro traduce a índice llevan posiciones en esta lista
    const listaCarreras: string[] = JSON.parse(
      document.getElementById("lista-carreras")?.textContent || "[]"
    );

    // Texto de búsqueda por tarjeta, calculado una vez aquí a partir del
    // contenido visible y de los nombres de las carreras; tenerlo como
    // atributo data-* duplicaba varios MB en el HTML
    const textosBusqueda = new Map<Element, string>();
    cards.forEach((card) => {
      const indices = (card.getAttribute("data-carreras") || "")
        .split(",")
        .filter(Boolean);
      const nombresCarreras = indices
        .map((i) => listaCarreras[Number(i)] || "")
        .join(" ");
      textosBusqueda.set(
        card,
        `${card.textContent || ""} ${nombresCarreras}`
          .replace(/\s+/g, " ")
          .toLowerCase()
      );
    });

    // Cascada de selects: las opciones que no aplican se QUITAN del DOM y
    // se reponen desde esta copia. Ocultarlas con hidden/disabled no
    // funciona en los selectores nativos de iOS/Android, que las ignoran.
    const opcionesOriginales = new Map<HTMLSelectElement, HTMLOptionElement[]>();
    [escuelaSelect, carreraSelect, municipioSelect].forEach((sel) => {
      if (sel) opcionesOriginales.set(sel, Array.from(sel.options));
    });

    const reconstruirSelect = (
      sel: HTMLSelectElement | null,
      aplica: (opcion: HTMLOptionElement) => boolean
    ) => {
      if (!sel) return;
      const valorActual = sel.value;
      const visibles = (opcionesOriginales.get(sel) || []).filter(
        (opcion) => !opcion.value || aplica(opcion) // la opción "Todas..." siempre queda
      );
      sel.replaceChildren(...visibles);
      // Conservar la selección si sigue disponible; si no, volver a "Todas"
      sel.value = visibles.some((opcion) => opcion.value === valorActual)
        ? valorActual
        : "";
    };

    // Actualiza las opciones de Escuela, Carrera y Municipio en cascada
    const actualizarOpcionesFiltros = () => {
      const nivelVal = nivelSelect?.value || "";

      // 1. Escuelas según el nivel (puede resetear la escuela elegida)
      reconstruirSelect(escuelaSelect, (opcion) => {
        const niveles = (opcion.getAttribute("data-niveles") || "").split(",");
        return !nivelVal || niveles.includes(nivelVal);
      });

      // 2. Carreras según nivel y escuela (leída ya reconstruida)
      const escuelaVal = escuelaSelect?.value || "";
      reconstruirSelect(carreraSelect, (opcion) => {
        const coincideNivel =
          !nivelVal || opcion.getAttribute("data-nivel") === nivelVal;
        const coincideEscuela =
          !escuelaVal || opcion.getAttribute("data-escuela") === escuelaVal;
        return coincideNivel && coincideEscuela;
      });

      // 3. Municipios/alcaldías según el estado
      const estadoVal = estadoSelect?.value || "";
      reconstruirSelect(municipioSelect, (opcion) => {
        return !estadoVal || opcion.getAttribute("data-estado") === estadoVal;
      });
    };

    // Función principal para aplicar filtros
    const aplicarFiltros = () => {
      const searchVal = searchInput?.value.toLowerCase().trim() || "";
      const isApoyoOnly = apoyoBtn.getAttribute("data-active") === "true";
      const nivelVal = nivelSelect?.value || "";
      const escuelaVal = escuelaSelect?.value || "";
      const carreraVal = carreraSelect?.value || "";
      const estadoVal = estadoSelect?.value || "";
      const municipioVal = municipioSelect?.value || "";

      let visibleCount = 0;

      // El select de carrera guarda nombres; las tarjetas, índices
      const carreraIdx =
        carreraVal === "" ? "" : String(listaCarreras.indexOf(carreraVal));

      cards.forEach((cardEl) => {
        const card = cardEl as HTMLElement;

        // 1. Filtro por Búsqueda de Texto
        const searchText = textosBusqueda.get(card) || "";
        const matchesSearch = !searchVal || searchText.includes(searchVal);

        // 2. Filtro por Apoyo Económico
        const isApoyo = card.getAttribute("data-apoyo") === "true";
        const matchesApoyo = !isApoyoOnly || isApoyo;

        // 3. Filtro por Nivel
        const cardNiveles = (card.getAttribute("data-niveles") || "").split(",");
        const matchesNivel = !nivelVal || cardNiveles.includes(nivelVal);

        // 4. Filtro por Escuela
        const cardEscuelas = (card.getAttribute("data-escuelas") || "").split(",");
        const matchesEscuela = !escuelaVal || cardEscuelas.includes(escuelaVal);

        // 5. Filtro por Carrera (índices en la lista global)
        const cardCarreras = (card.getAttribute("data-carreras") || "").split(",");
        const matchesCarrera = !carreraVal || cardCarreras.includes(carreraIdx);

        // 6. Filtro por Estado y Municipio
        const cardEntidad = card.getAttribute("data-entidad") || "";
        const cardUbicacion = card.getAttribute("data-ubicacion") || "";

        const matchesEstado = !estadoVal || cardEntidad === estadoVal;
        const matchesMunicipio = !municipioVal || cardUbicacion === municipioVal;
        const matchesUbicacion = matchesEstado && matchesMunicipio;

        const visible =
          matchesSearch &&
          matchesApoyo &&
          matchesNivel &&
          matchesEscuela &&
          matchesCarrera &&
          matchesUbicacion;

        if (visible) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      // Mostrar/ocultar estado vacío
      if (visibleCount === 0) {
        grid?.classList.add("hidden");
        noResultsState?.classList.remove("hidden");
      } else {
        grid?.classList.remove("hidden");
        noResultsState?.classList.add("hidden");
      }
    };

    // Inicializar opciones habilitadas basadas en la selección por defecto
    actualizarOpcionesFiltros();

    // Fija el estado (lógico y visual) del botón de apoyo económico
    const fijarApoyo = (activo: boolean) => {
      apoyoBtn.setAttribute("data-active", String(activo));
      if (activo) {
        apoyoBtn.classList.remove("bg-white", "text-slate-700", "border-slate-300", "dark:bg-slate-900", "dark:text-slate-200", "dark:border-slate-700");
        apoyoBtn.classList.add("bg-primario-600", "text-white", "border-primario-600", "dark:bg-primario-600", "dark:text-white", "dark:border-primario-600");
      } else {
        apoyoBtn.classList.add("bg-white", "text-slate-700", "border-slate-300", "dark:bg-slate-900", "dark:text-slate-200", "dark:border-slate-700");
        apoyoBtn.classList.remove("bg-primario-600", "text-white", "border-primario-600", "dark:bg-primario-600", "dark:text-white", "dark:border-primario-600");
      }
    };

    // Alternar estado activo del botón de apoyo económico
    apoyoBtn.addEventListener("click", () => {
      fijarApoyo(apoyoBtn.getAttribute("data-active") !== "true");
      aplicarFiltros();
    });

    // Botón "Limpiar filtros": restablece búsqueda, apoyo y todos los selects
    limpiarBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      fijarApoyo(false);
      [nivelSelect, escuelaSelect, carreraSelect, estadoSelect, municipioSelect].forEach(
        (sel) => {
          if (sel) sel.value = "";
        }
      );
      actualizarOpcionesFiltros();
      aplicarFiltros();
    });

    // Escuchar cambios en Nivel y actualizar opciones
    nivelSelect?.addEventListener("change", () => {
      actualizarOpcionesFiltros();
      aplicarFiltros();
    });

    // Escuchar cambios en Escuela y actualizar opciones
    escuelaSelect?.addEventListener("change", () => {
      actualizarOpcionesFiltros();
      aplicarFiltros();
    });

    // Escuchar cambios en Estado y actualizar opciones de municipios/alcaldías
    estadoSelect?.addEventListener("change", () => {
      actualizarOpcionesFiltros();
      aplicarFiltros();
    });

    // Registrar los demás escuchadores de eventos
    searchInput?.addEventListener("input", aplicarFiltros);
    carreraSelect?.addEventListener("change", aplicarFiltros);
    municipioSelect?.addEventListener("change", aplicarFiltros);

    // Evitar recarga al enviar formulario en esta misma página
    const form = searchInput?.closest("form");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      aplicarFiltros();
    });

    // Cargar término inicial desde la URL si existe
    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get("q");
    if (query && searchInput) {
      searchInput.value = query;
      aplicarFiltros();
    }
  }
</script>
