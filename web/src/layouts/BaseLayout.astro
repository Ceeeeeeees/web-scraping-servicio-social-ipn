---
/**
 * Layout base de todas las páginas.
 *
 * Incluye <head> con metadatos, el script de tema (claro/oscuro),
 * Header y Footer. Las páginas solo aportan su contenido al <slot />.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

// Fuentes autohospedadas (se sirven desde el propio bundle, sin depender
// de Google Fonts): Instrument Sans para títulos, Geist para el cuerpo.
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "@fontsource/instrument-sans/700.css";
import "@fontsource/geist/300.css";
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
import "@fontsource/geist/600.css";
import "@fontsource/geist/700.css";
import "@fontsource/geist/800.css";

interface Props {
  /** Título de la pestaña del navegador. */
  titulo: string;
  /** Descripción para el meta tag (SEO). */
  descripcion?: string;
}

const {
  titulo,
  descripcion = "Convocatorias de servicio social con apoyo económico para estudiantes universitarios de México.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo} | ServicioSocialMX</title>

    <!--
      Script inline (sin procesar) que aplica el tema ANTES de pintar la
      página, para evitar el parpadeo claro→oscuro. Prioridad:
      1. Preferencia guardada en localStorage.
      2. Preferencia del sistema operativo.
    -->
    <script is:inline>
      const tema =
        localStorage.getItem("tema") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "oscuro"
          : "claro");
      document.documentElement.classList.toggle("dark", tema === "oscuro");
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <svg class="hidden" aria-hidden="true">
      <defs>
        <symbol id="icono-map-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
          <circle cx="12" cy="10" r="3" />
        </symbol>
        <symbol id="icono-external-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </symbol>
      </defs>
    </svg>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
