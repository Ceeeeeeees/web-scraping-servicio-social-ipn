---
/**
 * Tarjeta de una convocatoria.
 *
 * Recibe una convocatoria y la muestra con detalles dinámicos.
 * Añade atributos data-* para habilitar el filtrado dinámico en el cliente.
 *
 * Estilos: las clases tarjeta-* viven en global.css (@layer components).
 * Con miles de tarjetas por página, las utilidades inline duplicaban el
 * peso del HTML; en el marcado solo van clases semánticas cortas y sin
 * comentarios HTML (se publicarían una vez por tarjeta).
 */
import type { Convocatoria } from "../types/convocatoria";
import {
  categorizarCarrera,
  eliminarEmojis,
  entidadDeUbicacion,
  formatearTitulo,
  formatearUbicacion,
  ubicacionDeConvocatoria,
} from "../utils/categorizer";

interface Props {
  convocatoria: Convocatoria;
  /**
   * Mapa carrera → índice en la lista global de la página. Si se pasa,
   * `data-carreras` lleva índices en vez de nombres completos: con miles
   * de tarjetas, repetir los nombres pesaba varios MB de HTML.
   */
  indicePorCarrera?: Map<string, number>;
  /**
   * Renderiza la tarjeta oculta (display: none). La página de
   * convocatorias muestra solo las primeras N y revela el resto por
   * lotes con "Mostrar más"; maquetar miles de tarjetas de golpe
   * congelaba el scroll en móvil.
   */
  oculta?: boolean;
}

const { convocatoria, indicePorCarrera, oculta = false } = Astro.props;

// Limpiar emojis de los textos del portal de origen
const tituloLimpio = formatearTitulo(eliminarEmojis(convocatoria.titulo));
const descripcionLimpia = eliminarEmojis(convocatoria.descripcion);
const institucionLimpia = eliminarEmojis(convocatoria.institucion);

// Categorizar todas las carreras para filtros client-side
const carrerasCategorizadas = (convocatoria.carreras || []).map(categorizarCarrera);

const niveles = Array.from(new Set(carrerasCategorizadas.map((c) => c.nivel)));
const escuelas = Array.from(new Set(carrerasCategorizadas.map((c) => c.escuela)));
const carrerasLista = Array.from(new Set(carrerasCategorizadas.map((c) => c.nombreOriginal)));

const dataNiveles = niveles.join(",");
const dataEscuelas = escuelas.join(",");
// Índices compactos si la página aporta la lista global; nombres si no
const dataCarreras = indicePorCarrera
  ? carrerasLista
      .map((c) => indicePorCarrera.get(c))
      .filter((i) => i !== undefined)
      .join(",")
  : carrerasLista.join("|");

// Ubicación: dato real del scraper, con la heurística por texto como respaldo
const ubicacionValor = ubicacionDeConvocatoria(convocatoria);
const ubicacion = formatearUbicacion(ubicacionValor);
const entidadValor = entidadDeUbicacion(ubicacionValor);

// Enlace a Google Maps con el domicilio completo (o la institución si falta)
const urlMaps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  convocatoria.direccion ?? institucionLimpia
)}`;

// El texto de búsqueda se calcula en el cliente (script de la página de
// convocatorias) a partir del contenido visible de la tarjeta y de
// data-carreras, para no duplicarlo aquí como atributo en cada tarjeta

// Etiquetas legibles para el estado de la convocatoria
const etiquetasEstado: Record<Convocatoria["estado"], string> = {
  abierta: "Abierta",
  cerrada: "Cerrada",
  proxima: "Próximamente",
};
---

<article
  class:list={["convocatoria-card", { hidden: oculta }]}
  data-apoyo={convocatoria.apoyoEconomico ? "true" : "false"}
  data-ubicacion={ubicacionValor}
  data-entidad={entidadValor}
  data-niveles={dataNiveles}
  data-escuelas={dataEscuelas}
  data-carreras={dataCarreras}
>
  <div class="tarjeta-cabecera">
    <span class="tarjeta-institucion">
      {institucionLimpia}
    </span>
    {
      convocatoria.apoyoEconomico && (
        <span class="tarjeta-apoyo">
          Con apoyo
          {convocatoria.monto != null && ` · $${convocatoria.monto.toLocaleString("es-MX")}/mes`}
        </span>
      )
    }
  </div>

  <div class="-mt-1">
    <h3 class="tarjeta-titulo">
      {tituloLimpio}
    </h3>

    <a
      href={urlMaps}
      target="_blank"
      rel="noopener noreferrer"
      title="Ver ubicación en Google Maps"
      class="tarjeta-mapa"
    >
      <svg class="tarjeta-icono-pin" aria-hidden="true"><use href="#icono-map-pin" /></svg>
      <span>{ubicacion}</span>
      <svg class="tarjeta-icono-ext" aria-hidden="true"><use href="#icono-external-link" /></svg>
    </a>
  </div>

  {
    descripcionLimpia && (
      <p class="tarjeta-descripcion">
        {descripcionLimpia}
      </p>
    )
  }

  {
    carrerasLista.length > 0 && (
      <div class="tarjeta-carreras">
        {carrerasLista.slice(0, 2).map((carr) => {
          const nombreSimplificado = carr
            .replace(/ESCOM\s+/i, "")
            .replace(/UPIITA\s+/i, "")
            .replace(/ESFM\s+/i, "")
            .replace(/ESIME\s+[A-Z]+\s+/i, "")
            .replace(/INGENIERÍA\s+EN\s+/i, "Ing. ")
            .replace(/LICENCIATURA\s+EN\s+/i, "Lic. ");

          return <span class="tarjeta-carrera">{nombreSimplificado}</span>;
        })}
        {carrerasLista.length > 2 && (
          <span class="tarjeta-carrera">+{carrerasLista.length - 2} más</span>
        )}
      </div>
    )
  }

  <div class="tarjeta-pie">
    <span class="tarjeta-origen">{convocatoria.universidadOrigen}</span>
    <span class={`tarjeta-estado ${convocatoria.estado === 'abierta' ? 'tarjeta-estado-abierta' : ''}`}>
      {etiquetasEstado[convocatoria.estado]}
    </span>
  </div>

  <a
    href={convocatoria.url}
    target="_blank"
    rel="noopener noreferrer"
    class="tarjeta-enlace"
  >
    Ver convocatoria original
    <svg class="size-3.5" aria-hidden="true"><use href="#icono-external-link" /></svg>
  </a>
</article>
