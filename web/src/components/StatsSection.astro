---
/**
 * Sección de estadísticas de la portada.
 *
 * Recibe los números ya calculados (ver utils/data.ts). Mientras el
 * scraper no genere datos, muestra los valores en cero.
 */
interface Props {
  total: number;
  conApoyo: number;
  universidades: number;
}

const { total, conApoyo, universidades } = Astro.props;

const estadisticas = [
  { valor: total, etiqueta: "Convocatorias registradas" },
  { valor: conApoyo, etiqueta: "Con apoyo económico" },
  { valor: universidades, etiqueta: "Universidades integradas" },
];
---

<section class="mx-auto max-w-4xl px-4 py-12">
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    {
      estadisticas.map((stat) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center dark:border-slate-800 dark:bg-slate-900">
          <dd class="text-4xl font-extrabold text-primario-600 dark:text-primario-400">
            {stat.valor}
          </dd>
          <dt class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            {stat.etiqueta}
          </dt>
        </div>
      ))
    }
  </dl>
</section>
