---
/**
 * Barra de búsqueda.
 *
 * Envía la búsqueda a la página de convocatorias mediante el parámetro URL `q`.
 */
import { Search } from "@lucide/astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<form action={`${base}/convocatorias`} method="GET" class="mx-auto w-full max-w-2xl px-4">
  <label class="relative block">
    <span class="sr-only">Buscar convocatorias</span>
    <Search
      class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400"
    />
    <input
      id="search-input"
      name="q"
      type="search"
      placeholder="Buscar por carrera, escuela, institución o palabra clave..."
      class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-slate-700 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primario-500 focus:border-transparent shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
    />
  </label>
</form>
